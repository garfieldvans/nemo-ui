{
  "name": "@nemo/ui",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Modern React component library with CSS Variables theming, dark mode, and full TypeScript support.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garfieldvans/nemo-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/garfieldvans/nemo-ui/issues",
  "homepage": "https://github.com/garfieldvans/nemo-ui#readme",
  "keywords": [
    "react",
    "component-library",
    "ui",
    "typescript",
    "css-variables",
    "dark-mode",
    "design-tokens"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": {
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.102.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}